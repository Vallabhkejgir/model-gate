# Private upstream Gemini API key (NEVER shared with consumers)
GEMINI_API_KEY=your_gemini_api_key_here

# Upstream OpenAI-compatible Gemini base URL
UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Operator master key for /admin/api/* and /admin web UI
ADMIN_MASTER_KEY=change_me_to_a_long_random_master_key

# Server-side HMAC pepper for hashing virtual consumer keys (vk_live_...)
KEY_HASH_PEPPER=change_me_to_a_32_byte_random_pepper

# Default virtual model alias and mapping (JSON object mapping virtual aliases -> upstream Gemini models)
DEFAULT_LIMITED_MODEL=limited-default
MODEL_MAP={"limited-default":"gemini-2.5-flash","gemini-flash-lite":"gemini-2.5-flash-lite","gemini-flash":"gemini-2.5-flash"}

# Cloud PostgreSQL connection string for persistent storage on Render / Neon / Supabase
# Leave empty to automatically fall back to local SQLite (DATABASE_PATH)
DATABASE_URL=

# Local SQLite database path (automatic fallback when DATABASE_URL is empty)
DATABASE_PATH=model_gate.db

# Sub-millisecond write-through in-memory virtual key cache TTL in seconds
KEY_CACHE_TTL_SECONDS=30.0

# Automatic retention cap for usage_logs table rows (prevents free-tier 0.5 GB DB exhaustion)
MAX_USAGE_LOG_ROWS=5000

# Optional zero-plaintext pre-hashed key records JSON for disaster-recovery seeding on startup
BOOTSTRAP_KEY_RECORDS=

# Request timeout in seconds for upstream calls
UPSTREAM_TIMEOUT_SECONDS=60.0

# Stream read timeout and SSE heartbeat keep-alive interval for long-running reasoning models
UPSTREAM_STREAM_READ_TIMEOUT_SECONDS=300.0
SSE_HEARTBEAT_INTERVAL_SECONDS=15.0

# Persistent upstream connection pool sizing
UPSTREAM_MAX_CONNECTIONS=100
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=20
